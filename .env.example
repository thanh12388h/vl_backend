# ==== Server ====
PORT=3000

# ==== MQTT Broker ====
# Khi DEV_EMBEDDED_BROKER=true, backend tự chạy 1 MQTT broker nhúng (Aedes)
# ngay trong tiến trình Node để test không cần broker ngoài (Mosquitto/HiveMQ...).
DEV_EMBEDDED_BROKER=true
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ==== Firebase ====
# mock  -> dùng kho dữ liệu JSON trong bộ nhớ (data/mock-db.json), phục vụ dev/test
# real  -> dùng Firebase Admin SDK thật (cần FIREBASE_SERVICE_ACCOUNT + FIREBASE_DB_URL)
FIREBASE_MODE=mock
FIREBASE_DB_URL=
FIREBASE_SERVICE_ACCOUNT=

# ==== Ngưỡng cảnh báo mặc định ====
SPO2_WARN_MIN=95
SPO2_CRITICAL_MIN=90
BPM_MIN_NORMAL=50
BPM_MAX_NORMAL=120

# ==== Cơ chế xác nhận bất thường ====
ALERT_CONSECUTIVE_COUNT=3
MOVING_AVERAGE_WINDOW=5

# ==== Heartbeat / mất kết nối ====
DEVICE_STATUS_INTERVAL_SEC=30
DEVICE_OFFLINE_TIMEOUT_SEC=90

# ==== Thông báo (tùy chọn - để trống nếu chỉ test nội bộ) ====
NOTIFY_EMAIL_ENABLED=false
NOTIFY_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
